# Salin ke .env lalu sesuaikan:  cp .env.example .env

# --- PostgreSQL ---
POSTGRES_DB=market
POSTGRES_USER=etl
POSTGRES_PASSWORD=ganti_password_ini
# Port Postgres di laptop (untuk DBeaver/psql). Ganti jika bentrok.
POSTGRES_HOST_PORT=5434

# --- Kafka topics ---
RAW_TOPIC=market.trades.raw
DLQ_TOPIC=market.trades.dlq
PROCESSOR_GROUP_ID=trade-processor

# --- Binance (tanpa API key) ---
# stream.binance.com diblokir di beberapa ISP Indonesia -> pakai endpoint market data resmi
BINANCE_WS_URL=wss://data-stream.binance.vision/stream
BINANCE_SYMBOLS=btcusdt,ethusdt,bnbusdt,solusdt,xrpusdt

# --- Finnhub (opsional, saham US) - daftar gratis di https://finnhub.io/register ---
FINNHUB_API_KEY=
FINNHUB_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,BINANCE:BTCUSDT

# --- Processor micro-batch ---
BATCH_SIZE=500
BATCH_TIMEOUT_MS=1000

# --- Airflow (UI: http://localhost:8081, user: admin) ---
AIRFLOW_ADMIN_PASSWORD=ganti_password_ini
